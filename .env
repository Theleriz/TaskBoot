# Example environment for Task Tracker.
# This file is committed and must contain placeholders only.
# Copy it to .env.local (ignored by git) and put real values there.
# See docs/secrets-policy.md.

# Folder for the native app's data.json. Leave empty to use %APPDATA%\TaskTracker.
# Note: the native app reads this from the process environment; it does not load .env files itself yet.
TASKTRACKER_DATA_DIR=
